# Copy to `.env` next to compose.yml (the bundle script writes one with random values). Keep it out of git.

# the address the game is served on (a DNS record for it must point at the server)
TRAINS_HOST=trains.example.org

# one invite code per friend: name:code, comma separated. The name is a label (shown in the lobby as the host);
# remove a pair to take that friend's access away, then `docker compose up -d`.
TW_INVITES=alice:CHANGE-ME-1,bob:CHANGE-ME-2

# signs the login cookies: long and random; changing it signs everybody out
TW_SECRET=CHANGE-ME-LONG-RANDOM

# the sign-in page's address: a long secret, starting with a slash
TW_LOGIN_PATH=/CHANGE-ME-SECRET-PATH

# the data folder of the build you deploy: the line in trainworld/data-version.txt
TW_DATA_VERSION=2026-11-19
